{
  "name": "fitness67",
  "version": "0.6.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/catalog-key.mjs && expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-scanner.mjs && node --experimental-strip-types --test tests/productSuggestions.test.ts",
    "test:browser": "node tests/scanner-browser.cjs",
    "build:web": "node scripts/catalog-key.mjs && expo export --platform web && node scripts/pwa.mjs",
    "apk": "node scripts/catalog-key.mjs && cd android && ./gradlew assembleRelease",
    "postinstall": "node scripts/catalog-key.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.8",
    "expo-sharing": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "typescript": "~5.9.2"
  }
}
